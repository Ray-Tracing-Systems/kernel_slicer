      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build_release/testapp",
      "args": [
        "--gpu"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build Release",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
