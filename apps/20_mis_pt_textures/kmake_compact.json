{
    "mainClass": "Integrator",
    "options": {
        "-compact_ds": 1,
        "-const_shit": 1,
        "end": ""
    },
    // for '-compact_ds' (ktest variants *_compact*): only buffers written by kernels are listed, other member vectors are read-only
    "kernels": {
        "all": {
            "nonConstantData": {
                "out_pakedXY": 1,
                "rayPosAndNear": 1,
                "rayDirAndFar": 1,
                "accumColor": 1,
                "accumuThoroughput": 1,
                "accumThoroughput": 1,
                "gen": 1,
                "rayFlags": 1,
                "out_hit": 1,
                "out_bars": 1,
                "out_hit1": 1,
                "out_hit2": 1,
                "out_color": 1,
                "a_gen": 1,
                "a_prevMisData": 1,
                "misPrev": 1,
                "out_shadeColor": 1,
                "a_accumColor": 1,
                "m_randomGens": 1
            }
        }
    },
    "source": [
        "test_class.cpp",
        "test_class2.cpp"
    ],
    "includeProcess": [
        "../RayTracing"
    ],
    "includeIgnore": [
        "../LiteMath",
        "../LiteMathAux"
    ],
    "defines": {
        "KERNEL_SLICER": ""
    },
    "end": ""
}
